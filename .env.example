# Clerk — publishable key is public; secret key is server-only.
# From https://dashboard.clerk.com → API keys (or `npx clerk@latest env pull`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Nexa backend API (see ../backend/README.md)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public production site URL, no trailing slash. Leave empty for local.
# NEXT_PUBLIC_SITE_URL=

# Optional. Comma-separated LAN IPs or hostnames allowed to load `next dev`
# from another device on the same Wi-Fi (a phone). Restart the dev server
# after changing next.config.ts or this variable.
# NEXT_DEV_ALLOWED_ORIGINS=
